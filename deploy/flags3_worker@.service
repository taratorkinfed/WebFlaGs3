[Unit]
Description=FlaGs3 RQ worker %i
After=network.target

[Service]
Type=simple
User=fe5657ta
Group=www-data
WorkingDirectory=/home/webapp/flags3_web
Environment="PATH=/home/webapp/flags3_web/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"
ExecStart=/home/webapp/flags3_web/venv/bin/rq worker --url redis://localhost:6379/0 --name flags3-%i flags3
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
