# Copied to .env on the server; .env is gitignored. Every key is optional and
# falls back to the value in config.py.
flags3_bin=/var/www/flags3/venv/bin/flags3
flags3_home=/var/www/flags3/home
jobs_dir=/home/webapp/flags3_web/jobs
ncbi_api_key=
redis_url=redis://localhost:6379/0
queue=flags3
results_ttl_hours=120
job_timeout=3h
cpu_per_job=4
max_lines=200
lab_url=https://server.atkinson-lab.com
site_name=FlaGs3
site_url=https://flags.atkinson-lab.com
contact_email=fedor.taratorkin@med.lu.se
# Job emails are sent only when smtp_user, mail_from and email_pass are all set.
smtp_host=smtps.lu.se
smtp_port=587
smtp_user=
mail_from=
email_pass=
